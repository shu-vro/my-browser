#!/bin/sh
# Checks run before every commit: formatting, lints, then the whole test suite
# (unit + end-to-end; the e2e tests open windows, so a GUI session is needed).
# CI runs the same checks. Enable once per clone:
#   git config core.hooksPath .githooks
# They check the working tree, so stage everything you changed. Skip only in
# an emergency: git commit --no-verify
set -eu
cd "$(git rev-parse --show-toplevel)"
# Documentation-only commits (the same paths CI ignores) skip the checks.
if ! git diff --cached --name-only | grep -qv -e '\.md$' -e '^docs/' -e '^previous-iterations/'; then
  echo "pre-commit: documentation only, skipping checks"
  exit 0
fi
echo "pre-commit: cargo fmt --check"
cargo fmt --check
echo "pre-commit: cargo clippy"
cargo clippy --release --all-targets --quiet -- -D warnings
echo "pre-commit: cargo test --release"
cargo test --release --quiet
