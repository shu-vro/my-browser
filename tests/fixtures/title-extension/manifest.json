{
  "manifest_version": 3,
  "name": "Title Marker",
  "version": "1.0",
  "description": "Test fixture: prefixes page titles on 127.0.0.1 with EXT; has a popup.",
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Title Marker",
    "default_popup": "popup.html"
  }
}
